    {
      "name": "OS — Público",
      "item": [
        {
          "name": "Criar OS",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  pm.collectionVariables.set('os_id', pm.response.json().id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"clienteId\": \"{{cliente_id}}\",\n  \"veiculoId\": \"{{veiculo_id}}\",\n  \"itensServico\": [\n    { \"servicoCatalogoId\": \"{{servico_id}}\", \"quantidade\": 1 }\n  ],\n  \"itensPeca\": [\n    { \"pecaEstoqueId\": \"{{peca_id}}\", \"quantidade\": 1 }\n  ]\n}"
            },
            "url": "{{baseUrl}}/ordens-servico"
          }
        },
        {
          "name": "Consultar status (por CPF/CNPJ)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/ordens-servico/{{os_id}}/status?cpfCnpj={{cpf_cnpj}}",
              "host": ["{{baseUrl}}"],
              "path": ["ordens-servico", "{{os_id}}", "status"],
              "query": [{ "key": "cpfCnpj", "value": "{{cpf_cnpj}}" }]
            }
          }
        },
        {
          "name": "Consultar status (por placa)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/ordens-servico/{{os_id}}/status?placa={{placa}}",
              "host": ["{{baseUrl}}"],
              "path": ["ordens-servico", "{{os_id}}", "status"],
              "query": [{ "key": "placa", "value": "{{placa}}" }]
            }
          }
        },
        {
          "name": "Aprovar orçamento",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"aprovado\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/ordens-servico/{{os_id}}/aprovacoes?cpfCnpj={{cpf_cnpj}}",
              "host": ["{{baseUrl}}"],
              "path": ["ordens-servico", "{{os_id}}", "aprovacoes"],
              "query": [{ "key": "cpfCnpj", "value": "{{cpf_cnpj}}" }]
            }
          }
        },
        {
          "name": "Rejeitar orçamento",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"aprovado\": false\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/ordens-servico/{{os_id}}/aprovacoes?cpfCnpj={{cpf_cnpj}}",
              "host": ["{{baseUrl}}"],
              "path": ["ordens-servico", "{{os_id}}", "aprovacoes"],
              "query": [{ "key": "cpfCnpj", "value": "{{cpf_cnpj}}" }]
