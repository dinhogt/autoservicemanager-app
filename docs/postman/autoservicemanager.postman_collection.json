                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"joao.silva@autoservice.local\",\n  \"password\": \"Senha@1234\"\n}"
            },
            "url": "{{baseUrl}}/auth/login"
          }
