  "item": [
    {
      "name": "1. AWS — Público via APIGW",
      "description": "Rotas expostas pelo API Gateway. Fluxo cliente autenticado por CPF (JWT RS256 emitido pela Lambda authCpf).",
      "item": [
        {
          "name": "1.1 Health check (público)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/health",
            "description": "Rota pública. Prova que APIGW → VPC Link → NLB → EKS pod → NestJS funciona. Esperado: 200 {\"status\":\"ok\"}."
          }
        },
        {
          "name": "1.2 Auth CPF (Lambda → RDS → JWT RS256)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const body = pm.response.json();",
                  "  pm.collectionVariables.set('jwt_token', body.token);",
                  "  console.log('JWT salvo. Expira em', body.expiresIn, 's');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cpf\": \"{{cpf}}\"\n}"
            },
            "url": "{{baseUrl}}/auth/cpf",
            "description": "Invoca a Lambda authCpf via APIGW. A Lambda lê Secrets Manager, consulta RDS MySQL, valida CPF e retorna JWT RS256 assinado com chave privada (JWKS em CloudFront). Esperado: 200 com {token, tokenType, expiresIn, expiresAt}."
          }
        },
        {
          "name": "1.3 [SEGURANÇA] Rota autenticada SEM token → 401",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/ordens-servico/{{os_id}}/status",
            "description": "Prova que o JWT Authorizer do APIGW bloqueia requests sem Bearer. Esperado: 401 Unauthorized."
          }
        },
        {
          "name": "1.4 Consultar status de OS (autenticado)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              }
            ],
            "url": "{{baseUrl}}/ordens-servico/{{os_id}}/status",
            "description": "Rota cliente autenticada por JWT RS256. Retorna status atual da OS + histórico. Se OS não existir: 404. Se OS existir: 200 com {status, dataAtualizacao}."
          }
        },
        {
          "name": "1.5 Criar OS (autenticado)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  pm.collectionVariables.set('os_id', pm.response.json().id);",
                  "  console.log('OS criada:', pm.response.json().id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"clienteId\": \"{{cliente_id}}\",\n  \"veiculoId\": \"{{veiculo_id}}\",\n  \"itensServico\": [\n    { \"servicoCatalogoId\": \"{{servico_id}}\", \"quantidade\": 1 }\n  ],\n  \"itensPeca\": [\n    { \"pecaEstoqueId\": \"{{peca_id}}\", \"quantidade\": 1 }\n  ]\n}"
            },
            "url": "{{baseUrl}}/ordens-servico",
            "description": "Cria uma nova Ordem de Serviço. Requer JWT de cliente. Salva o `id` retornado em {{os_id}} para chamadas subsequentes. Esperado: 201 com {id, status: 'RECEBIDA', ...}."
          }
        },
        {
          "name": "1.6 Aprovar orçamento",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"aprovado\": true\n}"
            },
            "url": "{{baseUrl}}/ordens-servico/{{os_id}}/aprovacoes",
            "description": "Cliente aprova o orçamento gerado pelo admin. Transição AGUARDANDO_APROVACAO → EM_EXECUCAO. Requer OS em status compatível (409 se não estiver)."
          }
        },
        {
          "name": "1.7 Rejeitar orçamento",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"aprovado\": false\n}"
            },
            "url": "{{baseUrl}}/ordens-servico/{{os_id}}/aprovacoes",
            "description": "Cliente rejeita o orçamento. Transição AGUARDANDO_APROVACAO → REJEITADA."
          }
        },
        {
          "name": "1.8 [SEGURANÇA] JWT cliente em rota admin → 401",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              }
            ],
            "url": "{{baseUrl}}/admin/clientes",
            "description": "Prova que o scope 'cliente' é rejeitado em rotas /admin/*. Esperado: 401 Unauthorized (separação de scopes)."
          }
        },
        {
          "name": "1.9 Webhook externo (HMAC)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Webhook-Secret",
                "value": "{{webhook_secret}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"EM_DIAGNOSTICO\"\n}"
            },
            "url": "{{baseUrl}}/webhooks/os/{{os_id}}/status",
            "description": "Sistema externo (ex: ERP) atualiza status da OS via webhook autenticado por segredo compartilhado (HMAC). Rode antes: kubectl get secret autoservice-secrets -n autoservice -o jsonpath='{.data.WEBHOOK_SECRET}' | base64 -d — e cole o valor em {{webhook_secret}}."
          }
        },
        {
          "name": "1.10 [SEGURANÇA] Root não mapeada → 404 do APIGW",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/",
            "description": "APIGW só expõe rotas específicas. Esperado: 404 {\"message\":\"Not Found\"}. Isso comprova que a superfície de ataque é mínima."
          }
        }
      ]
    },
    {
      "name": "2. AWS — Admin (port-forward)",
      "description": "Rotas /admin/* não são expostas publicamente pelo APIGW. Para acessar em homolog, use kubectl port-forward:\n\n  kubectl port-forward -n autoservice svc/autoservice-api 3000:80\n\nDepois estas requests batem em localhost:3000 = pod dentro do EKS (via túnel).",
      "item": [
        {
          "name": "2.1 Login admin (email/senha → JWT HS256)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201 || pm.response.code === 200) {",
                  "  const body = pm.response.json();",
                  "  const token = body.access_token || body.token;",
                  "  pm.collectionVariables.set('admin_token', token);",
                  "  console.log('Admin token salvo');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"joao.silva@autoservice.local\",\n  \"password\": \"Senha@1234\"\n}"
            },
            "url": "{{baseUrlAdmin}}/auth/login",
            "description": "Autenticação interna com email+senha. Retorna JWT HS256 com scope 'admin'. Requer que você tenha rodado `yarn db:seed` OU inserido admin manualmente (o job seed-clientes não cria admins)."
          }
        },
        {
          "name": "2.2 Listar OS (admin, priorizada)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrlAdmin}}/admin/ordens-servico?page=1&limit=20",
              "host": [
                "{{baseUrlAdmin}}"
              ],
              "path": [
                "admin",
                "ordens-servico"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "20"
                }
              ]
            }
          }
        },
        {
          "name": "2.3 Métricas — tempo médio",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}"
              }
            ],
            "url": "{{baseUrlAdmin}}/admin/ordens-servico/metricas/tempo-medio"
          }
        },
        {
          "name": "2.4 Obter OS por ID",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}"
              }
            ],
            "url": "{{baseUrlAdmin}}/admin/ordens-servico/{{os_id}}"
          }
        },
        {
          "name": "2.5 Histórico da OS",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}"
              }
            ],
            "url": "{{baseUrlAdmin}}/admin/ordens-servico/{{os_id}}/historico"
          }
        },
        {
          "name": "2.6 Iniciar diagnóstico",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}"
              }
            ],
            "url": "{{baseUrlAdmin}}/admin/ordens-servico/{{os_id}}/diagnostico"
          }
        },
        {
          "name": "2.7 Gerar orçamento",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}"
              }
            ],
            "url": "{{baseUrlAdmin}}/admin/ordens-servico/{{os_id}}/orcamento"
          }
        },
        {
          "name": "2.8 Finalizar OS",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}"
              }
            ],
            "url": "{{baseUrlAdmin}}/admin/ordens-servico/{{os_id}}/finalizacao"
          }
        },
        {
          "name": "2.9 Entregar veículo",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}"
              }
            ],
            "url": "{{baseUrlAdmin}}/admin/ordens-servico/{{os_id}}/entrega"
          }
        }
      ]
    },
