    {
      "name": "4. Fase 4 — Saga / Billing / Execution",
      "description": "Microsserviços Fase 4. Preferir a collection dedicada autoservicemanager-fase4.postman_collection.json para demo completa.",
      "item": [
        {
          "name": "4.1 Billing health (APIGW)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/billing/health/live",
            "description": ""
          }
        },
        {
          "name": "4.2 Consultar Saga",
          "request": {
            "method": "GET",
            "header": [
              {
