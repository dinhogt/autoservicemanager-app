# Template — NÃO aplicar com valores reais no git.
# Crie o secret no cluster:
#
# kubectl create secret generic autoservice-secrets -n autoservice \
#   --from-literal=DATABASE_URL='mysql://user:pass@rds-endpoint:3306/autoservicemanager' \
#   --from-literal=JWT_SECRET='...' \
#   --from-literal=WEBHOOK_SECRET='...' \
#   --from-literal=SMTP_HOST='email-smtp.us-east-1.amazonaws.com' \
#   --from-literal=SMTP_PORT='587' \
#   --from-literal=SMTP_USER='...' \
#   --from-literal=SMTP_PASS='...' \
#   --from-literal=EMAIL_FROM='noreply@example.com' \
#   --from-literal=MONGODB_URI='mongodb+srv://...'
#
apiVersion: v1
kind: Secret
metadata:
  name: autoservice-secrets
  namespace: autoservice
type: Opaque
stringData:
  DATABASE_URL: "REPLACE_ME"
  JWT_SECRET: "REPLACE_ME"
  WEBHOOK_SECRET: "REPLACE_ME"
  SMTP_HOST: ""
  SMTP_PORT: "587"
  SMTP_USER: ""
  SMTP_PASS: ""
  EMAIL_FROM: ""
  MONGODB_URI: ""
