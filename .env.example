# -----------------------------------------------------------------------------
# AutoServiceManager — environment variables
# Copy to `.env` and adjust values. Required vars are validated at startup.
# -----------------------------------------------------------------------------

# Application
NODE_ENV=development
PORT=3000
# LOG_FORMAT=json

# MySQL (Prisma) — required
# Example: mysql://USER:PASSWORD@HOST:3306/DATABASE
DATABASE_URL="mysql://user:password@localhost:3306/autoservicemanager"

# Shadow database for Prisma migrate dev — optional (only needed locally)
# SHADOW_DATABASE_URL="mysql://user:password@localhost:3306/autoservicemanager_shadow"

# CloudWatch EMF namespace suffix (optional; default NODE_ENV)
# METRICS_ENVIRONMENT=homolog

# SNS topic para notificações serverless (opcional — sem ARN usa SMTP local)
# OS_NOTIFICATIONS_TOPIC_ARN=arn:aws:sns:us-east-1:ACCOUNT:autoservicemanager-homolog-os-notifications
# AWS_REGION=us-east-1

# JWT signing secret — required (min. 16 characters) — admin HS256 only
JWT_SECRET="change-me-min-16-chars"

# E-mail (Mailtrap para demo local — copie credenciais do inbox Mailtrap para `.env`)
EMAIL_ENABLED=true
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=seu_user_mailtrap
SMTP_PASS=sua_senha_mailtrap
EMAIL_FROM=noreply@autoservice.local

# Webhook externo (atualização de status via integração)
WEBHOOK_SECRET=docker-compose-dev-webhook-secret-min-16

# CORS — obrigatório em production (allowlist separada por vírgula)
# CORS_ORIGIN=https://app.example.com,https://admin.example.com

# Swagger UI — desligado por default em production
# SWAGGER_ENABLED=false

# Fail-closed T1: exige header x-gateway-verified do API Gateway em production
# REQUIRE_GATEWAY_HEADERS=true

# Observabilidade (EKS / CloudWatch)
# AWS_XRAY_ENABLED=false
# AWS_XRAY_DAEMON_ADDRESS=127.0.0.1:2000
# AWS_XRAY_CONTEXT_MISSING=LOG_ERROR

# Seed do usuário admin (opcional — usado por `yarn db:seed`)
# ADMIN_SEED_EMAIL=admin@autoservice.local
# ADMIN_SEED_PASSWORD=admin123456
