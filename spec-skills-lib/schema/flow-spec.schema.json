{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.spec-skills-lib/schema/flow-spec.schema.json",
  "title": "FlowSpec",
  "description": "Upstream to downstream flow with quality gates and feedback loop.",
  "type": "object",
  "required": ["version", "name", "stages", "transitions", "gates"],
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "name": {
      "type": "string"
    },
    "stages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "role", "mode", "inputs", "outputs"],
        "properties": {
          "id": { "type": "string" },
          "role": { "type": "string" },
          "mode": { "type": "string", "enum": ["normal", "caveman"] },
          "inputs": { "type": "array", "items": { "type": "string" } },
          "outputs": { "type": "array", "items": { "type": "string" } },
          "skip_when": {
            "type": "string",
            "description": "Condition to skip stage, e.g. ai_features_enabled == false"
          }
        },
        "additionalProperties": false
      }
    },
    "transitions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["from", "to"],
        "properties": {
          "from": { "type": "string" },
          "to": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "gates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "stage_id", "criteria"],
        "properties": {
          "id": { "type": "string" },
          "stage_id": { "type": "string" },
          "criteria": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
          "on_fail": {
            "type": "string",
            "enum": ["rework_stage", "switch_to_normal_mode"]
          }
        },
        "additionalProperties": false
      }
    },
    "feedback_loop": {
      "type": "object",
      "required": ["from_stage", "to_stage", "trigger"],
      "properties": {
        "from_stage": { "type": "string" },
        "to_stage": { "type": "string" },
        "trigger": { "type": "string" }
      },
      "additionalProperties": false
    },
    "feedback_loops": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["from_stage", "to_stage", "trigger"],
        "properties": {
          "from_stage": { "type": "string" },
          "to_stage": { "type": "string" },
          "trigger": { "type": "string" }
        },
        "additionalProperties": false
      },
      "minItems": 1
    },
    "parallel_groups": {
      "type": "array",
      "description": "Explicit parallel fork/join groups for orchestration",
      "items": {
        "type": "object",
        "required": ["id", "stages", "join_stage"],
        "properties": {
          "id": { "type": "string" },
          "stages": {
            "type": "array",
            "items": { "type": "string" },
            "minItems": 2
          },
          "join_stage": { "type": "string" },
          "join_policy": {
            "type": "string",
            "enum": ["all", "any"],
            "default": "all"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "anyOf": [
    { "required": ["feedback_loop"] },
    { "required": ["feedback_loops"] }
  ]
}
