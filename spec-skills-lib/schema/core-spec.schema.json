{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.spec-skills-lib/schema/core-spec.schema.json",
  "title": "CoreSpec",
  "description": "Common contract for all role specs.",
  "type": "object",
  "required": [
    "id",
    "version",
    "role",
    "purpose",
    "mode",
    "inputs",
    "outputs",
    "constraints",
    "handoff"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "role": {
      "type": "string",
      "enum": [
        "business",
        "requirements",
        "architecture",
        "security",
        "infrastructure",
        "frontend",
        "backend",
        "observability",
        "documentation",
        "qa",
        "support-debug",
        "digital-business",
        "saas",
        "copywriting",
        "cloud",
        "finops",
        "discovery",
        "ux",
        "ai-engineering",
        "legal",
        "automation",
        "growth",
        "saas-ops"
      ]
    },
    "purpose": {
      "type": "string",
      "minLength": 10
    },
    "mode": {
      "type": "string",
      "enum": ["normal", "caveman"]
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "checklist": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "handoff": {
      "type": "object",
      "required": [
        "next_role",
        "goal",
        "artifacts",
        "done_criteria",
        "open_risks"
      ],
      "additionalProperties": false,
      "properties": {
        "next_role": {
          "type": "string"
        },
        "goal": {
          "type": "string",
          "minLength": 5
        },
        "constraints": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "artifacts": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "done_criteria": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "open_risks": {
          "type": "array",
          "maxItems": 3,
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
